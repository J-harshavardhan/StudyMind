{
  "name": "studymind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/src/server.js",
    "client": "npm --prefix client run dev",
    "dev:memory": "cross-env USE_MEMORY_DB=true concurrently \"node server/src/server.js\" \"npm --prefix client run dev\"",
    "seed": "cross-env SEED=true node server/src/seed.js",
    "build": "npm --prefix client run build",
    "lint": "eslint server/src client/src --ext .js,.jsx",
    "test": "cross-env NODE_ENV=test node --test --test-force-exit server/test/*.test.js",
    "test:client": "npm --prefix client run test"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.1",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true
  }
}
